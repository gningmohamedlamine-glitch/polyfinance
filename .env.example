# Copier en .env (jamais commité). Valeurs à prendre dans la console AWS de l'événement.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.openai.gpt-6-astra
MARKET_WEB_SEARCH=1
# Recherche web datée via Bedrock AgentCore en parallèle de Nova Web Grounding
MARKET_WEB_SEARCH_AGENTCORE=1
# Sans modèle, l'analyse s'arrête avec la raison exacte. Mettre 1 seulement pour tester sans Bedrock.
MARKET_ALLOW_LOCAL=0
# Soit un profil AWS (aws login --profile workshop)...
# AWS_PROFILE=workshop
# ...soit les identifiants temporaires : Workshop Studio > Get AWS CLI credentials (expirent après quelques heures)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Pour scripts/fetch_sources.py (SEC exige un nom et un courriel)
SEC_USER_AGENT=

# Limites partagées par toute une analyse (Enquêteur, Conseiller, recherche et synthèses).
ANALYSIS_TIMEOUT_SECONDS=90
# Recherche complémentaire : réserve 55 secondes aux synthèses dans le délai global.
ANALYSIS_RESEARCH_SECONDS=30
ANALYSIS_MAX_MODEL_CALLS=20
ANALYSIS_MAX_OUTPUT_TOKENS=50000
# Volume UTF-8 cumulé envoyé : plafond de taille, pas un comptage exact des tokens d’entrée.
ANALYSIS_MAX_INPUT_BYTES=1000000
ANALYSIS_MAX_NETWORK_CALLS=40
ANALYSIS_CACHE_TTL_SECONDS=900
